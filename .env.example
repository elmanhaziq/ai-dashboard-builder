# Copy to .env to override defaults. All settings are optional.

# Maximum upload size in MB (also update server.maxUploadSize in .streamlit/config.toml).
DASHBOARD_MAX_UPLOAD_MB=50

# Maximum rows loaded from one sheet (extra rows are skipped with a warning).
DASHBOARD_MAX_ROWS=1000000

# Folder that holds uploads/ and saved_dashboards/ (defaults to the project folder).
# DASHBOARD_DATA_DIR=C:\Users\you\DashboardData

# "local" (default on your computer) or "online" (shared web server with private per-visitor sessions).
# Streamlit Community Cloud is detected automatically.
# DASHBOARD_MODE=local

# Online mode: minutes of inactivity before a visitor's files and dashboards are deleted.
# DASHBOARD_SESSION_TTL_MINUTES=120

# ---- AI Analyst (optional) ----
# Pick ONE provider by adding its key. Without any, the built-in guided assistant runs offline.
# The AI is only used for analyses where you tick the consent box.

# Free, hosted open-source models (recommended): https://console.groq.com
# GROQ_API_KEY=gsk_...

# Free tier, Google Gemini (not open source): https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# Free ':free' models: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Local open-source models with Ollama (free, private; slow without a graphics card):
# DASHBOARD_LLM_PROVIDER=ollama
# DASHBOARD_LLM_MODEL=qwen3:4b

# Paid: Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# DASHBOARD_LLM_PROVIDER=auto        # auto | groq | gemini | openrouter | ollama | openai_compatible | anthropic | none
# DASHBOARD_LLM_MODEL=               # leave empty for each provider's default
# DASHBOARD_LLM_BASE_URL=            # for openai_compatible (LM Studio, vLLM, ...)
# DASHBOARD_LLM_API_KEY=

# Optional: require this code before visitors can use an AI provider (useful on a public deployment).
# DASHBOARD_AI_ACCESS_CODE=pick-a-code
